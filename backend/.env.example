# Google OAuth credentials must remain local. Never commit real values.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback
# Generate once and retain across restarts. This also derives the report-link signing key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
